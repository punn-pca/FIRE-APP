# Required by lib/db and the API server.
DATABASE_URL=postgresql://user:password@localhost:5432/firekeeper

# Used by the API server for Communication and Research Evaluation.
OPENAI_API_KEY=

# Session/configuration secret. Use a strong value outside local development.
SESSION_SECRET=

# The API server must bind to this port. Replit workflows provide it automatically.
PORT=8080

# Expo/Replit values are normally injected by the workflow.
# EXPO_PUBLIC_DOMAIN=
# EXPO_PUBLIC_REPL_ID=
# REPLIT_DEV_DOMAIN=
# REPLIT_EXPO_DEV_DOMAIN=
# REACT_NATIVE_PACKAGER_HOSTNAME=